* ================= CASE B3: VLC=+-0.28 V, L=9.4u, T/2=10.04n (swing 0.5 V, L=9.4uH) =================
VLCP_b3 vlcp_b3 0 DC 0.28
VLCN_b3 vlcn_b3 0 DC -0.28
BpLC_b3 pwpLC_b3 0 V = -(V(vlcp_b3)*I(VLCP_b3) + V(vlcn_b3)*I(VLCN_b3))
BdidtP_b3 didtP_b3 0 V = -ddt(I(VLCP_b3))
BdidtN_b3 didtN_b3 0 V =  ddt(I(VLCN_b3))
MPP_b3 a_b3 gPP_b3 vlcp_b3 vlcp_b3 PMOS1 W=60u L=0.18u
VgPP_b3 gPP_b3 0 PWL(0 0.28 1120.00n 0.28 1123.00n -0.28 1133.04n -0.28 1136.04n 0.28)
MN0_b3 a_b3 gN0_b3 0 vlcn_b3 NMOS1 W=10u L=0.18u
VgN0_b3 gN0_b3 0 PWL(0 -0.28 1142.04n -0.28 1145.04n 1.0 1155.08n 1.0 1158.08n -0.28)
MNN_b3 a_b3 gNN_b3 vlcn_b3 vlcn_b3 NMOS1 W=10u L=0.18u
VgNN_b3 gNN_b3 0 PWL(0 -0.28 1164.08n -0.28 1167.08n 1.28 1177.11n 1.28 1180.11n -0.28)
Rbig_b3 a_b3 0 100meg
CAC_b3  a_b3 0 100f
L_b3 a_b3 d_b3 9.40u
Vs_b3 d_b3 in_b3 DC 0
X_b3 in_b3 rA_b3 rB_b3 ternary_cell
BpC_b3 pwC_b3 0 V = V(in_b3)*I(Vs_b3)
BpG_b3 pwG_b3 0 V = V(gPP_b3)*I(VgPP_b3) + V(gN0_b3)*I(VgN0_b3) + V(gNN_b3)*I(VgNN_b3)
Vclk_b3 clk_b3 0 PWL(0 1 1137.54n 1 1138.04n 0 1140.04n 0 1140.54n 1 1159.58n 1 1160.08n 0 1162.08n 0 1162.58n 1 1181.61n 1 1182.11n 0 1184.11n 0 1184.61n 1)
XsaA_b3 0 rA_b3 clk_b3 vddsa outA_b3 outAb_b3 sensamp
XsaB_b3 rB_b3 0 clk_b3 vddsa outB_b3 outBb_b3 sensamp
BdA_b3 vdA_b3 0 V = V(outA_b3)-V(outAb_b3)
BdB_b3 vdB_b3 0 V = V(outB_b3)-V(outBb_b3)

