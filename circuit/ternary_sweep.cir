* ---------- global null case (idle driver, fixed) ----------
In 0 dN DC 0
RidleN dN 0 10meg
VsN dN drvN DC 0
RwN drvN xN 500
CxN xN 0 1p
RtermN xN 0 1meg
D1N xN rAn DIDEAL
D2N rBn xN DIDEAL
RLAN rAn 0 500
CLAN rAn 0 0.2p
RLBN rBn 0 500
CLBN rBn 0 0.2p
BpN pwpN 0 V = V(drvN)*I(VsN)

.tran 100p 200n

* ---------- measurements: 8 per instance ----------
.meas tran epush_X_ID_02_05_100_05 INTEG V(X_ID_02_05_100_05.pwpA) FROM=9n TO=26n
.meas tran epull_X_ID_02_05_100_05 INTEG V(X_ID_02_05_100_05.pwpB) FROM=39n TO=56n
