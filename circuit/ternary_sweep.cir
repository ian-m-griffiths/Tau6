* =====================================================================
* ternary_sweep.cir  --  lever sweep of the AC-polarity ternary cell
* Generated by make_ternary_sweep.py (do not edit by hand).
* 
* Levers swept (full grid, 96 instances):
*   diode : DIDEAL (IS=1e-14) / DSCHOTTKY (IS=1e-9, Vf~0.35V)
*   IP    : 0.2m, 0.5m, 1m        pulse amplitude
*   PW    : 0.5n, 1n, 3n, 10n     pulse width (rise=fall=PW/5)
*   RW    : 100, 500              wire resistance
*   CLINE : 0.5p, 1p              wire capacitance
* 
* Each instance is a full 4-case cell (push / pull / push->pull cycle);
* energy = INTEG V(drv)*I(Vs) over the transfer window at the driver.
* Measure windows are fixed literals: any window tail after the pulse
* sees zero driver current, so it adds nothing to the integral.
* =====================================================================

.options reltol=1e-3 abstol=1e-15 vntol=1e-6

* ---------- diode models ----------
.model DIDEAL D (IS=1e-14 RS=50 CJO=0.2p TT=2n N=1.0)
.model DSCHOTTKY D (IS=1e-9 RS=50 CJO=0.2p TT=1n N=1.05)

* ---------- parametrized cells (one per diode model) ----------
.subckt ternary_case vss ip=1m pw=3n rw=500 cl=1p
* ---- push (+1): 1mA pulse into the wire at 10..~14n ----
IpA 0 dA PULSE(0 {ip} 10n {pw/5} {pw/5} {pw} 200n)
VsA dA drvA DC 0
RwA drvA xA {rw}
CxA xA 0 {cl}
RtermA xA 0 1meg
D1A xA rAp DIDEAL
D2A rBp xA DIDEAL
RLAA rAp 0 500
CLAA rAp 0 0.2p
RLAB rBp 0 500
CLAB rBp 0 0.2p
BpA pwpA 0 V = V(drvA)*I(VsA)
* ---- pull (-1): -1mA at 40..~44n ----
IpB 0 dB PULSE(0 {-ip} 40n {pw/5} {pw/5} {pw} 200n)
VsB dB drvB DC 0
RwB drvB xB {rw}
CxB xB 0 {cl}
RtermB xB 0 1meg
D1B xB rAq DIDEAL
D2B rBq xB DIDEAL
RLBA rAq 0 500
CLBA rAq 0 0.2p
RLBB rBq 0 500
CLBB rBq 0 0.2p
BpB pwpB 0 V = V(drvB)*I(VsB)
* ---- push then pull back-to-back (charge recycling), 100n / 124n ----
Icy1 0 dC PULSE(0 {ip} 100n {pw/5} {pw/5} {pw} 200n)
Icy2 0 dC PULSE(0 {-ip} 124n {pw/5} {pw/5} {pw} 200n)
VsC dC drvC DC 0
RwC drvC xC {rw}
CxC xC 0 {cl}
RtermC xC 0 1meg
D1C xC rAc DIDEAL
D2C rBc xC DIDEAL
RLCA rAc 0 500
CLCA rAc 0 0.2p
RLCB rBc 0 500
CLCB rBc 0 0.2p
BpC pwpC 0 V = V(drvC)*I(VsC)
.ends

.subckt ternary_case_s vss ip=1m pw=3n rw=500 cl=1p
* ---- push (+1): 1mA pulse into the wire at 10..~14n ----
IpA 0 dA PULSE(0 {ip} 10n {pw/5} {pw/5} {pw} 200n)
VsA dA drvA DC 0
RwA drvA xA {rw}
CxA xA 0 {cl}
RtermA xA 0 1meg
D1A xA rAp DSCHOTTKY
D2A rBp xA DSCHOTTKY
RLAA rAp 0 500
CLAA rAp 0 0.2p
RLAB rBp 0 500
CLAB rBp 0 0.2p
BpA pwpA 0 V = V(drvA)*I(VsA)
* ---- pull (-1): -1mA at 40..~44n ----
IpB 0 dB PULSE(0 {-ip} 40n {pw/5} {pw/5} {pw} 200n)
VsB dB drvB DC 0
RwB drvB xB {rw}
CxB xB 0 {cl}
RtermB xB 0 1meg
D1B xB rAq DSCHOTTKY
D2B rBq xB DSCHOTTKY
RLBA rAq 0 500
CLBA rAq 0 0.2p
RLBB rBq 0 500
CLBB rBq 0 0.2p
BpB pwpB 0 V = V(drvB)*I(VsB)
* ---- push then pull back-to-back (charge recycling), 100n / 124n ----
Icy1 0 dC PULSE(0 {ip} 100n {pw/5} {pw/5} {pw} 200n)
Icy2 0 dC PULSE(0 {-ip} 124n {pw/5} {pw/5} {pw} 200n)
VsC dC drvC DC 0
RwC drvC xC {rw}
CxC xC 0 {cl}
RtermC xC 0 1meg
D1C xC rAc DSCHOTTKY
D2C rBc xC DSCHOTTKY
RLCA rAc 0 500
CLCA rAc 0 0.2p
RLCB rBc 0 500
CLCB rBc 0 0.2p
BpC pwpC 0 V = V(drvC)*I(VsC)
.ends

